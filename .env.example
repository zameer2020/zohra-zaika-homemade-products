# Zohra-Zaika environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public brand/contact settings (safe to expose to the browser).
# Existing valid number is used as the code default; override only if needed.
NEXT_PUBLIC_WHATSAPP_NUMBER=919032219521
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: set only when a flat delivery charge is confirmed by the business.
# Leave commented out to show "pending confirmation" instead of inventing a fee.
# NEXT_PUBLIC_DELIVERY_CHARGE_PAISE=0

# Server-only OpenRouter settings. Do NOT prefix the key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
# Change the model without editing code. The default is a free DeepSeek model;
# free models may be rate-limited or unavailable, so the UI falls back to WhatsApp.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional fallback used if the primary free model is busy or unavailable.
# OPENROUTER_FALLBACK_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
